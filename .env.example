# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Server port (frontend expects the API on this port by default)
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/snehjeetngo

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=

# Outgoing mail (Gmail SMTP) credentials
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Public frontend URL (used for password-reset links and CORS reference)
FRONTEND_URL=http://localhost:8080

# Address that receives admin notifications
ADMIN_EMAIL=

# Optional: transactional email provider (more reliable than Gmail in production)
# Get API key from SendGrid dashboard: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=
